{
  "name": "qkc",
  "version": "1.0.0-beta",
  "description": "QKC — Quick Knowledge Check: open-source black & white school knowledge trainer (grades K-11, 42k+ generated questions, offline-first PWA). By OuRi.",
  "license": "MIT",
  "private": false,
  "scripts": {
    "test": "node test/e2e.mjs",
    "build:bank": "python3 gen/assemble.py",
    "build:seo": "python3 gen/build_seo.py",
    "build:lit": "python3 gen/lit/build_lit.py",
    "build:lit:check": "python3 gen/lit/build_lit.py --check",
    "start": "python3 -m http.server 8099"
  },
  "keywords": [
    "quiz",
    "education",
    "vanilla-js",
    "pwa",
    "offline",
    "school",
    "trainer",
    "literature",
    "public-domain",
    "reader"
  ],
  "author": "Aleksandr Zhuravlev / OuRi <juravlev.aleksandr2020@gmail.com>",
  "dependencies": {
    "jsdom": "^29.1.1"
  }
}
